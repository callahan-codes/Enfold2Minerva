<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>enfold2minerva</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>enfold2minerva</ToolCommandName>
    <PackageId>Enfold2Minerva</PackageId>
    <AssemblyName>enfold2minerva</AssemblyName>
    <Version>1.1.0</Version>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <UserSecretsId>e076b7fe-79dd-42fc-918f-bc3bdaa5e0a8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

</Project>